# .env.example — copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Stellar RPC ──────────────────────────────────────────────────────────────

# Stellar RPC endpoint used by `soroscope profile --rpc`.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
SOROSCOPE_RPC_ENDPOINT=

# Timeout in seconds for RPC requests.
SOROSCOPE_RPC_TIMEOUT=10

# ── Profiler ─────────────────────────────────────────────────────────────────

# Default output format: table | json | csv
SOROSCOPE_OUTPUT=table

# CPU instruction budget. Profiler exits non-zero if exceeded. 0 = no limit.
SOROSCOPE_CPU_BUDGET=0

# Log level: error | warn | info | debug | trace
SOROSCOPE_LOG=warn

# ── Web UI ────────────────────────────────────────────────────────────────────

# Port for the local web development server.
SOROSCOPE_WEB_PORT=3000

# Next.js public base URL (used for API routes in the web UI).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Optional: Stellar Horizon (for fee context) ───────────────────────────────

# Horizon endpoint used to fetch current base fee for estimated cost display.
# Leave blank to disable fee estimation.
HORIZON_URL=https://horizon-testnet.stellar.org
