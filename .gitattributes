# .gitattributes

# Default: normalise line endings to LF in the repo
* text=auto eol=lf

# Rust source
*.rs text eol=lf

# Web source
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf

# Config and markup
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Shell scripts should always use LF even on Windows
*.sh text eol=lf

# Binary files — never diff or merge as text
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary

# Lock files — treat as binary to avoid noisy diffs
Cargo.lock binary
package-lock.json binary
